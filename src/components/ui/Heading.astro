---
interface Props {
    title: string;
    description: string;
    className?: string;
}

const { title, description, className = "" } = Astro.props;
---

<div class:list={["flex flex-col gap-3", className]}>
    <h3
        class="text-lg sm:text-2xl font-bold text-white tracking-wide drop-shadow-md"
    >
        {title}
    </h3>
    <p class="text-sm lg:text-xl leading-relaxed text-gray-200/90 font-normal">
        {description}
    </p>
</div>
