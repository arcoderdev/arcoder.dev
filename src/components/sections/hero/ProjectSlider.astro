---
import { Image } from "astro:assets";
import model from "@assets/slider-image-1.png";
import bull from "@assets/slider-image-2.png";
import house from "@assets/slider-image-3.png";
import RAIcon from "@icons/svg/RAIcon.svg?url";

interface Props {
  initialSlide?: 0 | 1 | 2;
}

const { initialSlide = 0 } = Astro.props;

const slides = [
  { image: bull, alt: "Ilustración 3D de un toro amarillo", className: "bull" },
  { image: model, alt: "Modelo 3D de una figura humana", className: "model" },
  { image: house, alt: "Modelo 3D de una casa", className: "house" },
];
---

<article
  class="project-slider"
  data-project-slider
  data-active={initialSlide}
  aria-label="Proyectos destacados"
>
  <div class="project-slider__stage">
    {
      slides.map((slide, index) => (
        <div
          class:list={["project-slider__slide", slide.className]}
          data-slide={index}
          aria-hidden={index !== initialSlide}
        >
          <Image
            src={slide.image}
            alt={slide.alt}
            width={516}
            height={494}
            loading={index === initialSlide ? "eager" : "lazy"}
            class={"w-full h-auto"}
          />
        </div>
      ))
    }
    <span class="project-slider__badge" aria-hidden="true">
      <Image
        class="project-slider__cube"
        src={RAIcon}
        width={32}
        height={32}
        alt=""
      />
    </span>
  </div>

  <div
    class="project-slider__controls"
    role="tablist"
    aria-label="Seleccionar proyecto"
  >
    {
      slides.map((slide, index) => (
        <button
          type="button"
          data-slider-dot={index}
          aria-label={`Mostrar ${slide.alt}`}
          aria-selected={index === initialSlide}
          role="tab"
        >
          <span />
        </button>
      ))
    }
  </div>
</article>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-project-slider]")
    .forEach((slider) => {
      const dots = Array.from(
        slider.querySelectorAll<HTMLButtonElement>("[data-slider-dot]"),
      );
      const slides = Array.from(
        slider.querySelectorAll<HTMLElement>("[data-slide]"),
      );
      let autoPlayTimer: number;

      const selectSlide = (index: number) => {
        slider.dataset.active = String(index);
        dots.forEach((dot, dotIndex) =>
          dot.setAttribute("aria-selected", String(dotIndex === index)),
        );
        slides.forEach((slide, slideIndex) =>
          slide.setAttribute("aria-hidden", String(slideIndex !== index)),
        );
      };

      const startAutoPlay = () => {
        window.clearInterval(autoPlayTimer);
        autoPlayTimer = window.setInterval(() => {
          const currentSlide = Number(slider.dataset.active ?? 0);
          selectSlide((currentSlide + 1) % slides.length);
        }, 5_000);
      };

      dots.forEach((dot, index) =>
        dot.addEventListener("click", () => {
          selectSlide(index);
          startAutoPlay();
        }),
      );

      startAutoPlay();
    });
</script>

<style>
  .project-slider {
    display: flex;
    width: 516px;
    height: 538px;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  .project-slider__stage {
    position: relative;
    width: 516px;
    height: 494px;
    overflow: hidden;
  }
  .project-slider__slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .project-slider__slide :global(img) {
    position: absolute;
    display: block;
    max-width: none;
    width: 516px;
    height: 494px;
    object-fit: cover;
  }
  .project-slider[data-active="0"] .project-slider__slide[data-slide="0"],
  .project-slider[data-active="1"] .project-slider__slide[data-slide="1"],
  .project-slider[data-active="2"] .project-slider__slide[data-slide="2"] {
    visibility: visible;
    opacity: 1;
  }
  .project-slider__badge {
    position: absolute;
    right: 40px;
    bottom: 20px;
    display: grid;
    width: auto;
    height: auto;
    padding: 4px;
    place-items: center;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 4px rgb(0 0 0 / 25%);
  }
  .project-slider__badge :global(img) {
    grid-area: 1 / 1;
  }
  .project-slider__cube {
    width: 32px;
    height: 32px;
  }
  .project-slider__controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .project-slider__controls button {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0px 0px 6px 0px rgba(255, 255, 255, 1);
    cursor: pointer;
    transition: 0.3s all ease-in-out;
  }
  .project-slider__controls button:hover {
    box-shadow: 0px 0px 6px 0px rgba(6, 37, 67, 1);
    background-color: var(--color-blue-page-800);
    transition: 0.3s all ease-in-out;
  }
  .project-slider__controls button[aria-selected="true"] {
    width: 44px;
    background: var(--color-blue-page-800);
    box-shadow: 0 0 3px #062543;
    transition: 0.3s all ease-in-out;
  }
  /* .project-slider__controls button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  } */
  @media (max-width: 900px) {
    .project-slider {
      width: 42vw;
      height: 47vw;
      min-width: 330px;
      min-height: 390px;
    }
    .project-slider__stage {
      width: 100%;
      height: calc(100% - 44px);
    }
  }
  @media (max-width: 700px) {
    .project-slider {
      width: min(100%, 516px);
      height: min(104vw, 538px);
      min-width: 0;
      min-height: 0;
      align-self: center;
    }
  }
</style>
