---
import { Image } from "astro:assets";
import cube from "../assets/cube.svg?url";
import model from "../assets/slider-image-3.png";
import bull from "../assets/slider-image-4.png";
import house from "../assets/slider-image-1.png";
import scanner from "../assets/scanner.svg?url";

interface Props {
  initialSlide?: 0 | 1 | 2;
}

const { initialSlide = 0 } = Astro.props;

const slides = [
  { image: bull, alt: "Ilustración 3D de un toro amarillo", className: "bull" },
  { image: model, alt: "Modelo 3D de una figura humana", className: "model" },
  { image: house, alt: "Modelo 3D de una casa", className: "house" },
];
---

<section class="project-slider" data-project-slider data-active={initialSlide} aria-label="Proyectos destacados">
  <div class="project-slider__stage">
    {
      slides.map((slide, index) => (
        <div class:list={["project-slider__slide", slide.className]} data-slide={index} aria-hidden={index !== initialSlide}>
          <Image src={slide.image} alt={slide.alt} width={516} height={494} loading={index === initialSlide ? "eager" : "lazy"} />
        </div>
      ))
    }
    <span class="project-slider__badge" aria-hidden="true">
      <Image class="project-slider__cube" src={cube} width={16} height={16} alt="" />
      <Image class="project-slider__scanner" src={scanner} width={24} height={24} alt="" />
    </span>
  </div>

  <div class="project-slider__controls" role="tablist" aria-label="Seleccionar proyecto">
    {
      slides.map((slide, index) => (
        <button type="button" data-slider-dot={index} aria-label={`Mostrar ${slide.alt}`} aria-selected={index === initialSlide} role="tab">
          <span></span>
        </button>
      ))
    }
  </div>
</section>

