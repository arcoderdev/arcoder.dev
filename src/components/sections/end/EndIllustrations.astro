---
import { Image } from "astro:assets";
import human from "@assets/end-section/human.svg";
import tree from "@assets/end-section/tree.svg";
import rock from "@assets/end-section/rock.svg";
import rock2 from "@assets/end-section/rock-2.svg";
import flower from "@assets/end-section/flower.svg";
---

<div
    class="absolute inset-0 w-full h-full pointer-events-none z-[2] overflow-y-auto overflow-x-hidden"
>
    <!-- Cluster Izquierdo: Humano + Planta + Roca -->
    <div
        class="absolute -left-4 md:left-8 lg:left-14 xl:left-24 bottom-6 sm:bottom-8 md:bottom-12 lg:bottom-14 z-[4]"
    >
        <Image
            src={human}
            alt="Persona con visor VR"
            class="w-28 sm:w-36 md:w-44 lg:w-52 xl:w-[220px] h-auto object-contain block"
        />
    </div>

    <!-- Planta izquierda (detrás de la roca) -->
    <div
        class="absolute left-20 sm:left-32 md:left-74 xl:left-90 bottom-43.5 md:bottom-55 z-[2]"
    >
        <Image
            src={flower}
            alt="Planta decorativa izquierda"
            class="w-9 sm:w-11 md:w-14 lg:w-18 xl:w-[83px] h-auto object-contain block -mb-1"
        />
    </div>

    <!-- Roca izquierda (3 montículos, sobre la línea del horizonte) -->
    <div
        class="absolute left-18 sm:left-28 md:left-70 xl:left-94 bottom-43.5 md:bottom-53 z-[3]"
    >
        <Image
            src={rock}
            alt="Rocas decorativas izquierda"
            class="w-14 sm:w-18 md:w-22 lg:w-28 xl:w-[130px] h-auto object-contain block -mb-0.5"
        />
    </div>

    <!-- Cluster Derecho: Árbol + Planta + Roca 2 (agrupados para anclarse al tronco) -->
    <div
        class="absolute -right-12 md:right-4 lg:right-1 xl:right-16 bottom-43.5 md:bottom-55 z-[2]"
    >
        <div class="relative">
            <!-- Árbol -->
            <Image
                src={tree}
                alt="Árbol ilustrado"
                class="w-44 sm:w-56 md:w-72 lg:w-88 xl:w-[407px] h-auto object-contain block -mb-0.5"
            />

            <!-- Planta derecha (al lado derecho del tronco) -->
            <div class="absolute left-[53%] bottom-0 z-[1]">
                <Image
                    src={flower}
                    alt="Planta decorativa base del árbol"
                    class="w-7 sm:w-9 md:w-11 lg:w-14 xl:w-[65px] h-auto object-contain block -mb-1"
                />
            </div>

            <!-- Roca derecha (2 montículos, en la base del tronco) -->
            <div class="absolute left-[36%] bottom-0 z-[2]">
                <Image
                    src={rock2}
                    alt="Rocas base del árbol"
                    class="w-12 sm:w-15 md:w-18 lg:w-22 xl:w-[101px] h-auto object-contain block -mb-0.5"
                />
            </div>
        </div>
    </div>
</div>
