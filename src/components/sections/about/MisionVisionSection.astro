---
import { Image } from "astro:assets";

interface Props {
    id: string;
    /** Etiqueta de la sección. */
    tag: string;
    /** Título de la sección. */
    title: string;
    /** Contenido de la sección. */
    content: string[];
    /** Imagen de la sección. */
    image: string;
    /** Orientación de la sección. */
    orientation: "left" | "right";
    /** Clases adicionales para la sección. */
    className?: string;
}

const {
    id,
    tag,
    title,
    content,
    image,
    orientation = "left",
    className = "mt-14 2xl:mt-28",
} = Astro.props;
---

<section id={id}>
    <div
        class:list={[
            "relative max-w-360 flex flex-col items-center justify-between gap-11 md:gap-0 mx-auto md:py-11 lg:py-24 px-6 md:px-0",
            className,
            orientation === "left" && "md:flex-row",
            orientation === "right" && "md:flex-row-reverse",
        ]}
    >
        <article
            class="w-auto flex flex-col items-start justify-center gap-5 md:p-8 rounded-3xl"
        >
            <small
                class="bg-blue-page-100 px-4 py-2 rounded-full text-xs text-blu-page-600 uppercase w-fit"
            >
                {tag}
            </small>
            <div class="w-full md:max-w-142.5 gap-8 flex flex-col items-start">
                <h3
                    class="uppercase text-white font-bold text-2xl md:text-[32px] lg:text-4xl leading-relaxed text-left"
                >
                    {title}
                </h3>
                <span class="w-full">
                    {
                        content.map((text, index) => (
                            <p
                                class:list={[
                                    "font-medium text-base md:text-xl text-white/80 leading-relaxed text-left",
                                    { "mb-5": index !== content.length - 1 },
                                ]}
                            >
                                {text}
                            </p>
                        ))
                    }
                </span>
            </div>
        </article>

        <article
            class="w-full max-w-90 md:max-w-100 lg:max-w-115 aspect-376/379 items-center justify-center shrink-0 relative md:sticky md:top-0"
        >
            <Image
                src={image}
                alt="Fondo decorativo"
                width={376}
                height={379}
                class="absolute inset-0 w-full h-full scale-80 object-contain select-none pointer-events-none opacity-80 -z-[10] blur-[100px]"
            />

            <div class="relative w-full h-full z-10 overflow-hidden">
                <Image
                    src={image}
                    alt={`Image: ${tag}`}
                    width={500}
                    height={500}
                    class="w-full h-full object-contain"
                />
            </div>
        </article>
    </div>
</section>
