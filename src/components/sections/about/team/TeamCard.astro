---
import type { TeamMember } from "@data/team-data";

interface Props {
    member: TeamMember;
}

const { member } = Astro.props as Props;

const formatPositions = (positions: string[]) => {
    if (positions.length <= 2) return positions.join(" - ").toUpperCase();
    return `${positions[0]} - ${positions[positions.length - 1]}`.toUpperCase();
};
---

<div
    class="team-card-container group relative flex flex-col w-full max-w-[320px] mx-auto cursor-pointer select-none"
    data-member-id={member.id}
>
    <div class="will-change-transform flex flex-col w-full">
        <div
            class="relative w-full aspect-832/1256 flex items-end justify-center overflow-hidden"
        >
            <div
                class="absolute bottom-0 w-full aspect-square transition-all duration-300 ease-out bg-square"
                style={`background-color: ${member.color}; `}
            >
            </div>

            <img
                src={member.image}
                alt={member.fullName}
                loading="lazy"
                decoding="async"
                class="relative z-10 w-full h-full object-cover object-bottom pointer-events-none drop-shadow-[0_12px_24px_rgba(0,0,0,0.4)] transition-transform duration-500 ease-out scale-100 group-hover:scale-110 origin-bottom"
            />
        </div>

        <div class="mt-4 flex flex-col items-start text-left gap-1 px-1">
            <h4
                class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug group-hover:text-blue-page-100 transition-colors duration-200"
            >
                {member.shortName}
            </h4>
            <p
                class="text-xs font-semibold tracking-wider uppercase text-gray-400 leading-normal"
            >
                {formatPositions(member.positions)}
            </p>
        </div>
    </div>
</div>
