---
import { badges } from "@data/badges-data";
---

<div
    class="hero-3d-wrapper w-full max-w-130 lg:max-w-145 xl:max-w-155 mx-auto select-none"
>
    <!-- Contenedor con perspectiva 3D -->
    <div
        id="hero-3d-scene"
        class="hero-3d-scene relative w-full aspect-500/465 flex items-center justify-center cursor-pointer"
    >
        <!-- Resplandor ambiental de fondo -->
        <div class="hero-ambient-glow" aria-hidden="true"></div>

        <!-- Escena inclinable en 3D -->
        <div id="hero-3d-card" class="hero-3d-card relative w-full h-full">
            <!-- Imagen base de la estructura -->
            <div
                class="hero-image-container relative w-full h-full flex items-center justify-center"
            >
                <img
                    id="hero-plan-image"
                    src="/experiencias-inmersivas/plano.png"
                    alt="Plano arquitectónico 3D interactivo"
                    width="500"
                    height="465"
                    class="hero-plan-image w-full h-full object-contain pointer-events-none"
                    loading="eager"
                    decoding="async"
                />
            </div>

            <!-- Capa de Badges flotantes en el espacio 3D -->
            <div class="hero-badges-layer absolute inset-0 pointer-events-none">
                {
                    badges.map((badge) => (
                        <div
                            class="hero-badge-slot absolute"
                            data-badge-id={badge.id}
                            data-parallax-factor={badge.parallaxFactor}
                            style={{
                                top: badge.top,
                                left: badge.left,
                                "--depth": badge.depth,
                                "--entrance-delay": badge.entranceDelay,
                                "--float-duration": badge.floatDuration,
                                "--float-delay": badge.floatDelay,
                                "--dot-color": badge.color,
                                "--dot-glow": badge.glowColor,
                            }}
                        >
                            <div class="hero-badge-float">
                                <div class="hero-badge-pill pointer-events-auto">
                                    <span class="hero-badge-dot" />
                                    <span class="hero-badge-text">
                                        {badge.label}
                                    </span>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</div>

<style>
    .hero-3d-wrapper {
        perspective: 1200px;
    }

    .hero-3d-scene {
        transform-style: preserve-3d;
        touch-action: pan-y;
    }

    .hero-3d-card {
        transform-style: preserve-3d;
        will-change: transform;
        transition: transform 0.12s cubic-bezier(0.2, 0.8, 0.2, 1);
        z-index: 1;
    }

    .hero-image-container {
        transform-style: preserve-3d;
        transform: translateZ(0px);
    }

    .hero-plan-image {
        filter: drop-shadow(0 20px 30px rgba(255, 255, 255, 0.05))
            drop-shadow(0 35px 50px rgba(25, 118, 210, 0.1));
        opacity: 0;
        transform: scale(0.92) translateY(24px);
        animation: imageEntrance 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-badges-layer {
        transform-style: preserve-3d;
    }

    .hero-badge-slot {
        transform-style: preserve-3d;
        will-change: transform;
        transform: translate3d(
            var(--px, 0px),
            var(--py, 0px),
            var(--depth, 50px)
        );
        opacity: 0;
        animation: badgeEntrance 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
        animation-delay: var(--entrance-delay);
    }

    .hero-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 4px 12px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.21);
        border-radius: 9999px;
        box-shadow:
            0 8px 24px -2px rgba(0, 0, 0, 0.5),
            inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);
        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            background-color 0.25s ease,
            box-shadow 0.25s ease;
        user-select: none;
    }

    .hero-badge-pill:hover {
        transform: scale(1.08) translateY(-2px);
        background: rgba(0, 0, 0, 0.8);
        border-color: rgba(255, 255, 255, 0.35);
    }

    .hero-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background-color: var(--dot-color);
        box-shadow:
            0 0 8px var(--dot-glow),
            0 0 14px var(--dot-color);
        flex-shrink: 0;
    }

    .hero-badge-text {
        color: #ffffff;
        font-size: 14px;
        font-weight: normal;
        line-height: normal;
        letter-spacing: normal;
        white-space: nowrap;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 640px) {
        .hero-badge-pill {
            padding: 0.25rem 0.65rem;
            gap: 0.4rem;
        }
        .hero-badge-text {
            font-size: 0.72rem;
        }
        .hero-badge-dot {
            width: 6px;
            height: 6px;
        }
    }

    @keyframes imageEntrance {
        0% {
            opacity: 0;
            transform: scale(0.9) translateY(28px);
        }
        100% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @keyframes badgeEntrance {
        0% {
            opacity: 0;
            transform: translate3d(
                    var(--px, 0px),
                    calc(var(--py, 0px) + 18px),
                    var(--depth, 50px)
                )
                scale(0.75);
        }
        100% {
            opacity: 1;
            transform: translate3d(
                    var(--px, 0px),
                    var(--py, 0px),
                    var(--depth, 50px)
                )
                scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-plan-image,
        .hero-badge-slot,
        .hero-3d-card {
            transition: none !important;
        }
    }
</style>

<script>
    function setupHeroParallax() {
        const scene = document.getElementById("hero-3d-scene");
        const card = document.getElementById("hero-3d-card");
        if (!scene || !card) return;

        const badgeSlots =
            scene.querySelectorAll<HTMLElement>(".hero-badge-slot");

        let currentRotateY = 0;
        let currentRotateX = 0;
        let targetRotateY = 0;
        let targetRotateX = 0;

        let currentParallaxX = 0;
        let currentParallaxY = 0;
        let targetParallaxX = 0;
        let targetParallaxY = 0;

        let isHovered = false;
        let animFrameId: number | null = null;

        // Máximos grados de rotación
        const MAX_ROT_Y = 5; // -5deg a +5deg
        const MAX_ROT_X = 3.5; // sutil inclinación vertical (-3.5deg a +3.5deg)
        const MAX_PARALLAX_OFFSET = 14; // Desplazamiento adicional para las badges en px

        function handlePointerMove(e: PointerEvent | MouseEvent) {
            const rect = scene!.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;

            // Coordenadas normalizadas de 0 a 1 dentro de la escena
            const normX = (e.clientX - rect.left) / rect.width;
            const normY = (e.clientY - rect.top) / rect.height;

            // Rango de -1 a 1 centrado en la escena
            const clampedX = Math.max(0, Math.min(1, normX));
            const clampedY = Math.max(0, Math.min(1, normY));
            const centeredX = (clampedX - 0.5) * 2; // -1 (izq) a +1 (der)
            const centeredY = (clampedY - 0.5) * 2; // -1 (arriba) a +1 (abajo)

            // Rotación Y
            targetRotateY = centeredX * MAX_ROT_Y;
            // Rotación X
            targetRotateX = -centeredY * MAX_ROT_X;

            // Desplazamiento de las badges
            targetParallaxX = centeredX * MAX_PARALLAX_OFFSET;
            targetParallaxY = centeredY * MAX_PARALLAX_OFFSET;
        }

        function handlePointerEnter() {
            isHovered = true;
            if (!animFrameId) {
                animFrameId = requestAnimationFrame(updateFrame);
            }
        }

        function handlePointerLeave() {
            isHovered = false;
            targetRotateY = 0;
            targetRotateX = 0;
            targetParallaxX = 0;
            targetParallaxY = 0;
        }

        function updateFrame() {
            const ease = 0.085;
            currentRotateY += (targetRotateY - currentRotateY) * ease;
            currentRotateX += (targetRotateX - currentRotateX) * ease;
            currentParallaxX += (targetParallaxX - currentParallaxX) * ease;
            currentParallaxY += (targetParallaxY - currentParallaxY) * ease;

            // Aplicar rotación 3D a la tarjeta principal
            card!.style.transform = `rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg)`;

            // Mover las badges en la dirección del mouse
            badgeSlots.forEach((slot) => {
                const factor = parseFloat(slot.dataset.parallaxFactor || "1");
                const px = (currentParallaxX * factor).toFixed(2);
                const py = (currentParallaxY * factor).toFixed(2);
                slot.style.setProperty("--px", `${px}px`);
                slot.style.setProperty("--py", `${py}px`);
            });

            // Continuar renderizando si hay movimiento o si aún está en hover
            const delta =
                Math.abs(targetRotateY - currentRotateY) +
                Math.abs(targetRotateX - currentRotateX) +
                Math.abs(targetParallaxX - currentParallaxX) +
                Math.abs(targetParallaxY - currentParallaxY);

            if (isHovered || delta > 0.01) {
                animFrameId = requestAnimationFrame(updateFrame);
            } else {
                card!.style.transform = "rotateX(0deg) rotateY(0deg)";
                badgeSlots.forEach((slot) => {
                    slot.style.setProperty("--px", "0px");
                    slot.style.setProperty("--py", "0px");
                });
                animFrameId = null;
            }
        }

        scene.addEventListener("pointermove", handlePointerMove, {
            passive: true,
        });
        scene.addEventListener("pointerenter", handlePointerEnter);
        scene.addEventListener("pointerleave", handlePointerLeave);

        // Soporte touch
        scene.addEventListener(
            "touchmove",
            (e: TouchEvent) => {
                if (e.touches.length > 0) {
                    handlePointerMove(e.touches[0] as unknown as PointerEvent);
                }
            },
            { passive: true },
        );
        scene.addEventListener("touchend", handlePointerLeave);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupHeroParallax);
    } else {
        setupHeroParallax();
    }
    document.addEventListener("astro:page-load", setupHeroParallax);
</script>
