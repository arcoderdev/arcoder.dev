---
interface Props {
    id: string;
    title: string;
    description: string;
    className?: string;
    color: string;
}

const { id, title, description, className, color } = Astro.props;
---

<div
    id={id}
    class:list={[
        "milestone-card flex flex-col items-center gap-2 text-center",
        className,
    ]}
>
    <div
        class="px-4 py-2.5 rounded-xl bg-black/10 md:bg-black/20 backdrop-blur-lg border border-white/15 shadow-2xl"
    >
        <h4 class="text-sm font-semibold" style={`color: ${color};`}>
            {title}
        </h4>
        <p class="text-white/80 text-xs mt-0.5 leading-snug">
            {description}
        </p>
    </div>
</div>
