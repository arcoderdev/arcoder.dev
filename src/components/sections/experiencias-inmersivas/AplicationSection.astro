---
import ItemAplications from "./ItemAplications";
---

<section id="aplications" class="relative mt-14 2xl:mt-28">
    <div
        class="relative w-full flex flex-col md:flex-row items-center justify-between max-w-360 mx-auto py-6 lg:py-24 px-6 gap-11 md:gap-22.25"
    >
        <div class="w-full md:max-w-142.5 gap-8 flex flex-col items-start">
            <h3
                class="text-white font-bold text-2xl md:text-[32px] lg:text-4xl leading-relaxed text-left"
            >
                Aplicaciones
            </h3>
            <p class="text-white/80">
                Modelo aplicable a diferente áreas destacando la arquitectura,
                el diseño de interiores, paisajismo, museos, parques, hoteles y
                universidades.
            </p>
        </div>
        <ItemAplications client:visible />
    </div>

    <div
        class="w-full h-full absolute -bottom-20 left-0 -z-1 bg-[url('/bg-aplicaciones.png')] bg-cover bg-center bg-no-repeat overlay"
    >
    </div>
</section>

<style>
    .overlay {
        opacity: 0.1;
        -webkit-mask-image: radial-gradient(
            ellipse 71% 55% at 50% 50%,
            black 20%,
            transparent 65%
        );
        mask-image: radial-gradient(
            ellipse 71% 55% at 50% 50%,
            black 20%,
            transparent 65%
        );
    }
</style>
