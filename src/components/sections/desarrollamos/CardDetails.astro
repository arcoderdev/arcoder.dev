---
import { Monitor } from "@lucide/astro";

interface Props {
    icon: typeof Monitor;
    label: string;
}

const { icon: Icon, label = "Desarrollo de software" } = Astro.props;
---

<div
    class="p-3 gap-3 xl:gap-6 flex flex-col items-center justify-center bg-linear-to-b from-white/20 via-white/30 to-white/20 rounded-[20px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] backdrop-blur-xl text-center"
>
    <Icon class="size-6 xl:size-8 text-white" />
    <p class="font-normal text-xs xl:text-sm text-white">{label}</p>
</div>
