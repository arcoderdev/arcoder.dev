---
import CardImage from "./CardImage.astro";
import CardDetails from "./CardDetails.astro";
import TextContainer from "./TextContainer.astro";
import { type CardData } from "@interfaces/card.interface";

const {
    imageSrc = "",
    details = [],
    icon,
    labelBadge,
    title,
    description,
} = Astro.props as CardData;
---

<div
    class="desarrollamos-card-content relative flex flex-col xl:flex-row justify-center items-center max-w-90 md:max-w-120 xl:max-w-360 w-full h-140 md:h-180 xl:h-full mx-auto xl:px-20 xl:py-8"
>
    <div class="desarrollamos-img-box relative aspect-624/960 w-full h-full">
        <CardImage imgSrc={imageSrc} />
        <div
            class="absolute inset-0 w-full h-full xl:flex items-end justify-center gap-4 p-4 xl:gap-8 xl:p-8 hidden"
        >
            {
                details.map(({ icon, labelText }) => (
                    <CardDetails icon={icon} label={labelText} />
                ))
            }
        </div>
    </div>
    <div
        class="desarrollamos-text-box absolute inset-0 xl:relative xl:inset-auto w-full xl:max-w-156 p-4 xl:p-6 xl:pl-16 h-full flex items-end xl:items-center justify-center bg-linear-to-b from-black/0 to-black/50 rounded-[40px] xl:from-transparent xl:to-transparent"
    >
        <TextContainer
            iconBadge={icon}
            textBadge={labelBadge}
            title={title}
            description={description}
        />
    </div>
</div>

<style>
    @media (orientation: landscape) and (max-height: 600px),
        (max-height: 520px) {
        .desarrollamos-card-content {
            height: min(320px, 86vh) !important;
            max-height: 86vh !important;
            flex-direction: row !important;
            gap: 1.5rem !important;
            max-width: 90vw !important;
            padding: 0.5rem 1rem !important;
        }

        .desarrollamos-img-box {
            height: 100% !important;
            width: auto !important;
            max-width: 38vw !important;
        }

        .desarrollamos-text-box {
            position: relative !important;
            inset: auto !important;
            height: auto !important;
            max-width: 50vw !important;
            padding: 0.5rem !important;
            background: transparent !important;
            align-items: center !important;
        }
    }
</style>
