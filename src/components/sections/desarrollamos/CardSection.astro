---
import CardImage from "./CardImage.astro";
import CardDetails from "./CardDetails.astro";
import TextContainer from "./TextContainer.astro";
import { type CardData } from "@interfaces/card.interface";

const {
    imageSrc = "",
    details = [],
    icon,
    labelBadge,
    title,
    description,
} = Astro.props as CardData;
---

<div
    class="relative flex flex-col xl:flex-row justify-center items-center max-w-90 md:max-w-120 xl:max-w-360 w-full h-140 md:h-180 xl:h-full mx-auto xl:px-20 xl:py-8"
>
    <div
        class="relative aspect-624/960 w-full md:max-w-120 xl:max-w-156 h-full"
    >
        <CardImage imgSrc={imageSrc} />
        <div
            class="absolute inset-0 w-full h-full xl:flex items-end justify-center gap-4 p-4 xl:gap-8 xl:p-8 hidden"
        >
            {
                details.map(({ icon, labelText }) => (
                    <CardDetails icon={icon} label={labelText} />
                ))
            }
        </div>
    </div>
    <div
        class="absolute inset-0 xl:relative xl:inset-auto w-full xl:max-w-156 p-4 xl:p-6 xl:pl-16 h-full flex items-end xl:items-center justify-center bg-linear-to-b from-black/0 to-black/50 rounded-[40px] xl:from-transparent xl:to-transparent"
    >
        <TextContainer
            iconBadge={icon}
            textBadge={labelBadge}
            title={title}
            description={description}
        />
    </div>
</div>
