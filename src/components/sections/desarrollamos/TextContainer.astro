---
import { CodeXml } from "@lucide/astro";

interface Props {
    iconBadge?: typeof CodeXml;
    textBadge: string;
    title: string;
    description: string;
}

const {
    iconBadge: IconBadge = CodeXml,
    textBadge = "text para badge",
    title = "titulo de tarjeta",
    description = "descripcion para la tarjeta",
} = Astro.props;
---

<article class="text-white flex flex-col items-start gap-5">
    <div
        class="flex items-center gap-2 px-3 py-1 bg-white/20 backdrop-blur-xl rounded-[100px]"
    >
        <IconBadge class="size-4 md:size-5 text-white" />
        <p class="uppercase text-xs md:text-sm">{textBadge}</p>
    </div>
    <div class="flex flex-col items-start gap-4 xl:gap-8">
        <h3
            class="uppercase font-semibold text-xl md:text-[32px] xl:text-[40px]"
        >
            {title}
        </h3>
        <p class="text-sm md:text-base xl:text-xl font-normal">{description}</p>
    </div>
</article>
