---
import Main from "@layouts/Main.astro";
import HeroContainer from "@components/sections/hero/HeroContainer.astro";
import Tagline from "@components/sections/hero/Tagline.astro";
import ProjectSlider from "@components/sections/hero/ProjectSlider.astro";
import BackgroundHero from "@components/sections/hero/BackgroundHero.astro";
import DisenamosSection from "@components/sections/disenamos/DisenamosSection.astro";
import { MoveDown } from "@lucide/astro";
import DesarrollamosSection from "@components/sections/desarrollamos/DesarrollamosSection.astro";
import EndSection from "@components/sections/end/EndSection.astro";
import ContactSection from "@components/sections/contact/ContactSection.astro";
---

<Main
    title="ARcoder.dev | Donde la visión digital se convierte en realidad"
    description="Creamos soluciones digitales a medida: arte 3D, diseño UX/UI, desarrollo web y software, recorridos virtuales y experiencias de realidad aumentada y virtual."
    ogImage="/og/home.webp"
>
    <BackgroundHero />
    <HeroContainer
        className="flex flex-col lg:flex-row items-center justify-between mt-6 gap-10 sm:mt-16 mb-14 2xl:mb-28"
    >
        <Tagline
            label="Donde la visión digital se convierte en realidad"
            description="Creamos experiencias que trascienden."
            align="left"
            button="cta"
            ctaText="Demos vida a tu idea digital"
            ctaLink="#contact-section"
        />
        <ProjectSlider />
        <MoveDown
            class="size-6 md:size-8 transition-all transform animate-bounce absolute -bottom-16 left-1/2 -translate-x-1/2 text-white"
        />
    </HeroContainer>

    <DisenamosSection />

    <DesarrollamosSection />

    <EndSection />

    <ContactSection />
</Main>
